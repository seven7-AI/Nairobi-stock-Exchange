# Copy to deployment/.env (gitignored) and fill in real values.
# Never commit a populated copy of this file.

# --- service ---------------------------------------------------------------
APP_NAME=nse-be
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["https://your-frontend.example"]

# --- security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The service refuses to start in production while this is the dev default.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Production floor is 12; the service refuses to start below it.
BCRYPT_ROUNDS=12

# --- database --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=nse
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@postgres:5432/nse
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- upstream market data (external scraper owns this table) ---------------
SUPABASE_URL=
SUPABASE_KEY=
STOCKANALYSIS_TABLE=stockanalysis_stocks
HISTORICAL_DAYS_BACK=365

# --- redis / celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Leave false while the GitHub Actions report workflows are enabled, or every
# report is generated twice.
CELERY_BEAT_ENABLED=false

# --- email -----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@your-domain.example
