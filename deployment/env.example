# Copy to deployment/.env (gitignored) and fill in real values.
# Never commit a populated copy of this file.

# --- service ---------------------------------------------------------------
APP_NAME=nse-be
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["https://your-frontend.example"]

# --- security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The service refuses to start in production while this is the dev default.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Production floor is 12; the service refuses to start below it.
BCRYPT_ROUNDS=12

# --- database --------------------------------------------------------------
# The DSN is composed from these parts, so the password lives in exactly one
# place and is URL-encoded for you. Set DATABASE_URL only if your provider
# hands you a single connection string; it then takes precedence.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nse
DATABASE_URL=
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- NSE scraper data source (where market data comes from) ----------------
# The ~/nse-stock-scraper project runs a daily Scrapy job under cron and writes
# to its own local SQLite database. nse-be reads that database read-only.
#
# NSE_SCRAPER_HOST_PATH is the path ON THE HOST, used by the compose bind mount.
# NSE_SCRAPER_PATH is the path INSIDE the container, used by the application.
NSE_SCRAPER_HOST_PATH=/home/kevin/nse-stock-scraper
NSE_SCRAPER_PATH=/srv/scraper
# Optional: override if the SQLite file is not at <path>/data/nse_scraper.sqlite3
NSE_SCRAPER_DB_PATH=
NSE_SCRAPER_READ_TIMEOUT_SECONDS=5.0
# The scraper runs daily at 09:00 Africa/Nairobi; 36h tolerates one missed run.
NSE_SCRAPER_STALE_AFTER_HOURS=36
HISTORICAL_DAYS_BACK=365

# --- Supabase (registered but NOT used for market data) --------------------
# The scraper switched to DB_BACKEND=sqlite and its Supabase writes had been
# failing daily since July. Kept only so the connectors API can describe and
# test a Supabase link.
SUPABASE_URL=
SUPABASE_KEY=
STOCKANALYSIS_TABLE=stockanalysis_stocks

# --- redis / celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Leave false while the GitHub Actions report workflows are enabled, or every
# report is generated twice.
CELERY_BEAT_ENABLED=false

# --- email -----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@your-domain.example
